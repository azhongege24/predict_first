        <string notr="true">QPushButton{
    border:1px solid rgb(107, 224, 210);   /* 边框：浅薄荷绿（呼应背景） */
    border-radius:15px;    /* 圆角半径（不变） */
    padding:2px 4px;  /* 内边距（不变） */
    background-color: rgb(173, 240, 232);	/* 常态背景：淡薄荷绿 */
    color:rgb(34, 51, 59);		/* 字体颜色：深灰色（可读性强，不突兀） */
    font: bold 18pt &quot;楷体&quot;;  /* 字体格式合并（不变） */
}

QPushButton:hover {
    background-color: rgb(196, 246, 240);    /* 悬停背景：更浅的薄荷绿（提亮反馈） */
}

QPushButton:pressed {
    background-color: rgb(82, 206, 192);     /* 点击背景：深薄荷绿（按压厚重感） */
}</string>
