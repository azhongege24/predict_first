       <property name="styleSheet">
        <string notr="true">QPushButton{
border:1px solid red;   /*边框的粗细，颜色*/
border-radius:15px;    /*设置圆角半径 */
padding:2px 4px;  /*QFrame边框与内部其它部件的距离*/
background-color: rgb(149, 236, 165);	/*背景颜色*/
color:rgb(0, 0, 0);		/*字体颜色*/
	font: 18pt &quot;楷体&quot;;

font:bold;
}
QPushButton:hover {
    background-color: rgb(177, 244, 155);    /* 悬停时背景色 */
}
QPushButton:pressed {
    background-color:rgb(99, 181, 255);     /* 点击时背景色 */
}</string>
