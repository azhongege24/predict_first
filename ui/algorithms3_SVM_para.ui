       <item>
        <widget class="QLabel" name="label_3">
         <property name="minimumSize">
          <size>
           <width>0</width>
           <height>30</height>
          </size>
         </property>
         <property name="toolTip">
          <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;将数据映射到高维空间的函数，用于处理非线性问题。&lt;span style=&quot; font-family:'Courier New';&quot;&gt;linear&lt;/span&gt;（线性）, &lt;span style=&quot; font-family:'Courier New';&quot;&gt;rbf&lt;/span&gt;（径向基）, &lt;span style=&quot; font-family:'Courier New';&quot;&gt;poly&lt;/span&gt;（多项式）, &lt;span style=&quot; font-family:'Courier New';&quot;&gt;sigmoid&lt;/span&gt;&lt;/p&gt;&lt;p&gt;。默认为 &lt;span style=&quot; font-family:'Courier New';&quot;&gt;rbf&lt;/span&gt;。模型性能的关键。线性可分或特征维度高时用&lt;span style=&quot; font-family:'Courier New';&quot;&gt;linear&lt;/span&gt;（速度快）；非线性问题优先尝试&lt;span style=&quot; font-family:'Courier New';&quot;&gt;rbf&lt;/span&gt;；特定领域（如文本）可能用&lt;span style=&quot; font-family:'Courier New';&quot;&gt;poly&lt;/span&gt;或&lt;span style=&quot; font-family:'Courier New';&quot;&gt;sigmoid&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>
         <property name="styleSheet">
          <string notr="true">QLabel {
    border: 1px solid rgb(70, 130, 180);   /* 增强为科研蓝边框，参考Nature期刊图表色 */
    border-radius: 8px;
    padding: 4px 8px;
    background-color: rgb(255, 255, 255);  /* 纯白背景提升对比度 */
    color: rgb(30, 80, 120);               /* 深海军蓝文字，对比度达8:1 */
    font: bold 16pt &quot;Times New Roman&quot;;     
    qproperty-alignment: 'AlignCenter';
    /* 强化阴影效果 */
}

QLabel:hover {
    border-color: rgb(0, 100, 180);        /* 悬停时使用更高饱和的科研蓝 */
    background-color: rgb(240, 248, 255);  /* 极浅蓝悬停反馈 */
}

QLabel:pressed {
    background-color: rgb(220, 240, 255);  /* 按压状态模拟墨水渗透效果 */
}</string>
         </property>
         <property name="text">
          <string>kernel</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="label_2_C">
         <property name="minimumSize">
          <size>
           <width>0</width>
           <height>30</height>
          </size>
         </property>
         <property name="font">
          <font>
           <family>Times New Roman</family>
           <pointsize>16</pointsize>
           <weight>75</weight>
           <italic>false</italic>
           <bold>true</bold>
          </font>
         </property>
         <property name="toolTip">
          <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-size:12pt;&quot;&gt;惩罚系数，平衡“分类间隔最大化”和“误分类点容忍度”。通常在对数尺度上搜索，如 &lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:12pt;&quot;&gt;[0.01, 0.1, 1, 10, 100]&lt;/span&gt;&lt;span style=&quot; font-size:12pt;&quot;&gt;控制过拟合与欠拟合。&lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:12pt;&quot;&gt;C&lt;/span&gt;&lt;span style=&quot; font-size:12pt;&quot;&gt;值越大，对误分类惩罚越重，模型越复杂，易过拟合；&lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:12pt;&quot;&gt;C&lt;/span&gt;&lt;span style=&quot; font-size:12pt;&quot;&gt;值越小，模型泛化能力越强，但可能欠拟合&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>
         <property name="styleSheet">
          <string notr="true">QLabel {
    border: 1px solid rgb(70, 130, 180);   /* 增强为科研蓝边框，参考Nature期刊图表色 */
    border-radius: 8px;
    padding: 4px 8px;
    background-color: rgb(255, 255, 255);  /* 纯白背景提升对比度 */
    color: rgb(30, 80, 120);               /* 深海军蓝文字，对比度达8:1 */
    font: bold 16pt &quot;Times New Roman&quot;;     
    qproperty-alignment: 'AlignCenter';
    /* 强化阴影效果 */
}

QLabel:hover {
    border-color: rgb(0, 100, 180);        /* 悬停时使用更高饱和的科研蓝 */
    background-color: rgb(240, 248, 255);  /* 极浅蓝悬停反馈 */
}

QLabel:pressed {
    background-color: rgb(220, 240, 255);  /* 按压状态模拟墨水渗透效果 */
}</string>
         </property>
         <property name="text">
          <string>C</string>
         </property>
        </widget>
       </item>
