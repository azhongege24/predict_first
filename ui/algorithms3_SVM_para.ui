          </size>
         </property>
         <property name="toolTip">
          <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-size:12pt;&quot;&gt;指定用于训练的CPU核心数，用于并行计算以加速训练。&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system,BlinkMacSystemFont,Segoe UI,PingFang SC,Microsoft YaHei'; font-size:12pt; font-weight:400; color:rgba(0,0,0,0.898039);&quot;&gt;-1&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system,BlinkMacSystemFont,Segoe UI,PingFang SC,Roboto,Ubuntu,Helvetica Neue,Helvetica,Arial,Hiragino Sans GB,Microsoft YaHei UI,Microsoft YaHei,Source Han Sans CN,sans-serif'; font-size:12pt; font-weight:400; color:rgba(0,0,0,0.898039); background-color:#ffffff;&quot;&gt;（使用全部核心），&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system,BlinkMacSystemFont,Segoe UI,PingFang SC,Microsoft YaHei'; font-size:12pt; font-weight:400; color:rgba(0,0,0,0.898039);&quot;&gt;1&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system,BlinkMacSystemFont,Segoe UI,PingFang SC,Roboto,Ubuntu,Helvetica Neue,Helvetica,Arial,Hiragino Sans GB,Microsoft YaHei UI,Microsoft YaHei,Source Han Sans CN,sans-serif'; font-size:12pt; font-weight:400; color:rgba(0,0,0,0.898039); background-color:#ffffff;&quot;&gt;（默认，不并行），大于1的整数（指定核心数）&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system,BlinkMacSystemFont,Segoe UI,PingFang SC,Microsoft YaHei'; font-size:12pt; color:rgba(0,0,0,0.898039);&quot;&gt;显著减少训练时间&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system,BlinkMacSystemFont,Segoe UI,PingFang SC,Roboto,Ubuntu,Helvetica Neue,Helvetica,Arial,Hiragino Sans GB,Microsoft YaHei UI,Microsoft YaHei,Source Han Sans CN,sans-serif'; font-size:12pt; font-weight:400; color:rgba(0,0,0,0.898039); background-color:#ffffff;&quot;&gt;，特别在网格搜索或大数据集时。但并非核心数越多越好，需考虑内存消耗。&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>
