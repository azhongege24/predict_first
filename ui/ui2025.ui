       <item>
        <widget class="QPushButton" name="pushButton_8">
         <property name="styleSheet">
          <string notr="true">QPushButton {
    border: 1px solid rgb(60, 75, 90);       /* 深灰蓝边框，类似实验仪器金属色 */
    border-radius: 8px;                      /* 适中圆角更显严谨 */
    background-color: rgb(240, 245, 250);    /* 极浅灰蓝背景，参考实验室白板 */
    color: rgb(30, 50, 70);                 /* 深灰蓝文字，如学术文献印刷色 */
    font: bold 14pt &quot;微软雅黑&quot;;
    min-width: 85px;
    min-height: 42px;
 
}

QPushButton:hover {
    background-color: rgb(220, 230, 240);    /* 悬停时轻微加深背景 */
    border-color: rgb(40, 60, 80);          /* 加深边框模拟金属反光 */
    color: rgb(20, 40, 60);                 /* 文字颜色同步加深 */
}

QPushButton:pressed {
    background-color: rgb(60, 75, 90);      /* 按压状态与边框同色 */
    color: rgb(230, 235, 240);              /* 浅灰白文字确保可读性 */
}

QPushButton:disabled {
    background-color: rgb(250, 250, 250);    /* 禁用状态极浅灰 */
    color: rgb(180, 190, 200);              /* 灰蓝文字表示不可用 */
    border-color: rgb(210, 220, 230);
}</string>
         </property>
         <property name="text">
          <string>保存预测结果</string>
         </property>
        </widget>
       </item>
