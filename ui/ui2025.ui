    color: #0c2c84;                     /* 深蓝字体 */
    font:  14pt  &quot;楷体&quot; ;
    min-width: 80px;
font:bold;
    min-height: 40px;
}

QPushButton:hover {
    background-color: #7bccc4;          /* 悬浮时：蓝绿色 */
    border-color: #0868ac;              /* 加深边框 */
    color: #f7fcfd;                     /* 悬停文字改为白色 */
}

QPushButton:pressed {
    background-color: #4eb3d3;          /* 按压时：科技蓝 */
    border-color: #084081;              /* 深蓝边框 */
}</string>
       </property>
       <property name="text">
        <string>多门控
