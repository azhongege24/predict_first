}

QPushButton:pressed {
    background-color: #4eb3d3;          /* 按压时：科技蓝 */
    border-color: #084081;              /* 深蓝边框 */
}</string>
       </property>
       <property name="text">
        <string>Reweighted
Multitask
Wasserstein</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="pushButton_begin_to_predict">
       <property name="toolTip">
        <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;这是加载预训练模型后可点击的开始预测按钮&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
       </property>
       <property name="styleSheet">
        <string notr="true">QPushButton{
    border:1px solid #64748B;   /* 浅灰蓝色边框，低调不突兀 */
    border-radius:15px;          /* 保持原有圆角设计 */
    padding:2px 4px;             /* 保持内边距 */
    background-color:#EFF6FF;    /* 淡蓝灰色背景，柔和不刺眼 */
    color:#1E293B;               /* 深灰蓝色文字，清晰易读 */
    font: 16pt &quot;楷体&quot;;           /* 保持原有字体 */
    min-width:80px;              /* 保持最小宽度 */
    min-height:40px;             /* 保持最小高度 */
    font:bold;
}

QPushButton:hover {
    background-color: #93C5FD;   /* 悬停时浅天蓝色，温和反馈 */
    color: #FFFFFF;              /* 悬停时白色文字，提升对比度 */
}

QPushButton:pressed {
    background-color: #3B82F6;   /* 按下时标准蓝色，明确反馈（科研常用主色调） */
}</string>
       </property>
       <property name="text">
        <string>开始预测</string>
       </property>
