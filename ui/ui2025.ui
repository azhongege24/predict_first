     <item>
      <widget class="QPushButton" name="pushButton_5">
       <property name="styleSheet">
        <string notr="true">QPushButton {
    border: 1px solid #2b8cbe;           /* 科技蓝边框 */
    border-radius: 15px;
    padding: 2px 4px;
    background-color: #e0f3f8;           /* 浅蓝灰背景 */
